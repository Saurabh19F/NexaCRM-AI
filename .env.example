# ═══════════════════════════════════════════════════════════════
#  NexaCRM AI — Environment Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_NAME=NexaCRM AI
APP_ENV=development           # development | staging | production
APP_PORT_FRONTEND=3000
APP_PORT_BACKEND=8080

# ── Database (PostgreSQL) ────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/nexacrm
DB_USERNAME=nexacrm
DB_PASSWORD=nexacrm123
DB_NAME=nexacrm
POSTGRES_PORT=5432

# ── JWT Security ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-key-here-minimum-64-chars
JWT_EXPIRATION_MS=86400000        # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# ── OpenAI (GPT-4) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1500
VITE_OPENAI_KEY=sk-your-openai-api-key-here

# ── Email (SMTP / Gmail) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password   # Use App Password, NOT your real password
EMAIL_FROM_NAME=NexaCRM AI
EMAIL_FROM_ADDRESS=noreply@nexacrm.com

# ── Meta (Facebook & Instagram) ─────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_TOKEN=your-webhook-verify-token
META_PAGE_ACCESS_TOKEN=your-page-access-token

# ── WhatsApp Business Cloud API ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_API_VERSION=v19.0

# ── LinkedIn API ─────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/integrations/linkedin/callback

# ── Gmail / Google Calendar ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── AWS S3 ───────────────────────────────────────────────────────
AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_BUCKET=nexacrm-files
AWS_REGION=ap-south-1

# ── Cloudinary (image/avatar storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── Tally XML API ────────────────────────────────────────────────
TALLY_HOST=http://localhost
TALLY_PORT=9000

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend Vite ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_APP_NAME=NexaCRM AI
VITE_APP_VERSION=1.0.0
